    "GET /beers": {
      "provenance": "operation-contract",
      "contract": {
        "operationId": "getBeers",
        "parameters": [
          {
            "description": "Page number for pagination",
            "in": "query",
            "name": "page",
            "required": false,
            "schema": {
              "default": 1,
              "minimum": 1,
              "type": "integer"
            }
          },
          {
            "description": "Number of items to return per page",
            "in": "query",
            "name": "per_page",
            "required": false,
            "schema": {
              "default": 30,
              "maximum": 80,
              "minimum": 10,
              "type": "integer"
            }
          },
          {
            "description": "Filter beers by name (partial match)",
            "in": "query",
            "name": "beer_name",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "description": "Comma-separated list of beer IDs to retrieve",
            "in": "query",
            "name": "ids",
            "required": false,
            "schema": {
              "example": "1,2,3",
              "type": "string"
            }
          },
          {
            "description": "Filter beers brewed before the specified date (format: MM-YYYY or YYYY)",
            "in": "query",
            "name": "brewed_before",
            "required": false,
            "schema": {
              "example": "12-2018",
              "type": "string"
            }
          },
          {
            "description": "Filter beers brewed after the specified date (format: MM-YYYY or YYYY)",
            "in": "query",
            "name": "brewed_after",
            "required": false,
            "schema": {
              "example": "01-2015",
              "type": "string"
            }
          },
          {
            "description": "Filter beers with ABV greater than the specified value",
            "in": "query",
            "name": "abv_gt",
            "required": false,
            "schema": {
              "example": 5,
              "type": "number"
            }
          },
          {
            "description": "Filter beers with ABV less than the specified value",
            "in": "query",
            "name": "abv_lt",
            "required": false,
            "schema": {
              "example": 10,
              "type": "number"
            }
          },
          {
            "description": "Filter beers with IBU greater than the specified value",
            "in": "query",
            "name": "ibu_gt",
            "required": false,
            "schema": {
              "example": 40,
              "type": "number"
            }
          },
          {
            "description": "Filter beers with IBU less than the specified value",
            "in": "query",
            "name": "ibu_lt",
            "required": false,
            "schema": {
              "example": 100,
              "type": "number"
            }
          },
          {
            "description": "Filter beers with EBC greater than the specified value",
            "in": "query",
            "name": "ebc_gt",
            "required": false,
            "schema": {
              "example": 20,
              "type": "number"
            }
          },
          {
            "description": "Filter beers with EBC less than the specified value",
            "in": "query",
            "name": "ebc_lt",
            "required": false,
            "schema": {
              "example": 50,
              "type": "number"
            }
          },
          {
            "description": "Filter beers that pair well with the specified food",
            "in": "query",
            "name": "food",
            "required": false,
            "schema": {
              "example": "chicken",
              "type": "string"
            }
          }
        ],
        "protocol": "http",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "properties": {
                      "abv": {
                        "description": "Alcohol by volume percentage",
                        "example": 4.7,
                        "format": "float",
                        "type": "number"
                      },
                      "attenuation_level": {
                        "description": "Attenuation level percentage",
                        "example": 86,
                        "format": "float",
                        "type": "number"
                      },
                      "boil_volume": {
                        "properties": {
                          "unit": {
                            "description": "Unit of measurement",
                            "example": "litres",
                            "type": "string"
                          },
                          "value": {
                            "description": "Volume value",
                            "example": 20,
                            "format": "float",
                            "type": "number"
                          }
                        },
                        "type": "object"
                      },
                      "brewers_tips": {
                        "description": "Tips from the brewers",
                        "example": "Temperature control is extremely important for Lager, fermentation temperature around 10-12°C and a maturation period of 3-4 weeks at 1.5-2°C is ideal.",
                        "type": "string"
                      },
                      "contributed_by": {
                        "description": "Contributor information",
                        "example": "Alexander Ivanovsky <alxiw>",
                        "type": "string"
                      },
                      "description": {
