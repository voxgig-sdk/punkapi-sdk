                            "items": {
                              "properties": {
                                "amount": {
                                  "properties": {
                                    "unit": {
                                      "description": "Unit of measurement",
                                      "example": "kilograms",
                                      "type": "string"
                                    },
                                    "value": {
                                      "description": "Amount value",
                                      "example": 3.36,
                                      "format": "float",
                                      "type": "number"
                                    }
                                  },
                                  "type": "object"
                                },
                                "name": {
                                  "description": "Name of the malt",
