# Entity: image

main: kit: entity: image: {

  alias: field: {}

  fields: [
    {
      name: "id"
      req: false
      type: "`$STRING`"
    }
  ]

  id: {
    field: "id"
    name: "id"
  }

  name: "image"
  op: {
    load: {
      name: "load"
      points: [
        {
          args: {
            params: [
              {
                example: "366.png"
                kind: "param"
                name: "id"
                orig: "filename"
                reqd: true
                type: "`$STRING`"
              }
            ]
          }
          method: "GET"
          orig: "/images/{filename}"
          rename: {
            param: {
              filename: "id"
            }
          }
          segments: [
            {
              lit: "images"
            }
            {
              var: "id"
            }
          ]
          select: {
            exist: [
              "id"
            ]
          }
          transform: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
      ]
    }
  }



}
