# Entity: image

main: kit: entity: image: {

  alias: field: {}

  fields: [
    {
      name: "id"
      req: false
      type: "`$STRING`"
    }
  ]

  id: {
    field: "id"
    name: "id"
  }

  name: "image"
  op: {
    load: {
      name: "load"
      points: [
        {
          args: {
            params: [
              {
                example: "366.png"
                kind: "param"
                name: "id"
                orig: "filename"
                reqd: true
                type: "`$STRING`"
              }
            ]
          }
          contract: {
            id: "GET /images/{filename}"
            json: "{\"operationId\":\"getBeerImage\",\"parameters\":[{\"description\":\"Image filename (from the beer's image field)\",\"in\":\"path\",\"name\":\"filename\",\"required\":true,\"schema\":{\"example\":\"366.png\",\"type\":\"string\"}}],\"protocol\":\"http\",\"responses\":{\"200\":{\"content\":{\"image/png\":{\"schema\":{\"format\":\"binary\",\"type\":\"string\"}}},\"description\":\"Successful response\"},\"404\":{\"description\":\"Image not found\"},\"500\":{\"description\":\"Internal server error\"}},\"securitySource\":\"unspecified\"}"
            source: "openapi3"
            version: 1
          }
          method: "GET"
          orig: "/images/{filename}"
          rename: {
            param: {
              filename: "id"
            }
          }
          segments: [
            {
              lit: "images"
            }
            {
              var: "id"
            }
          ]
          select: {
            exist: [
              "id"
            ]
          }
          transform: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
      ]
    }
  }



}
